# Server
PORT=3000
NODE_ENV=development

# Database
# Primary DB on VM 2
DATABASE_URL="postgresql://postgres:postgres_password@vm2-ip-or-host:5432/whatsapp_db?schema=public"
# Temporary / Failover DB on VM 1 (local)
DATABASE_URL_TEMP="postgresql://postgres:postgres_password@localhost:5432/whatsapp_temp?schema=public"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# Single User Authentication (Credentials)
AUTH_EMAIL="admin@whatsapp.local"
AUTH_PASSWORD="your-strong-password-here"
AUTH_NAME="Admin"

# Logging
LOG_LEVEL=info
